# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Connection
# Set to an external MongoDB instance or Atlas connection string.
# If omitted or offline in development, an embedded in-memory MongoDB is automatically started.
MONGODB_URI=mongodb://127.0.0.1:27017/document_management

# Storage Configuration
UPLOAD_DIR=./storage/documents
TEMP_UPLOAD_DIR=./storage/tmp
MAX_FILE_SIZE_MB=5

# Frontend API Base URL (empty for relative /api path or specify full URL)
VITE_API_BASE_URL=
