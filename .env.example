# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Atlas / Database Connection
# Connects to MongoDB Atlas or local MongoDB instance.
# If omitted or unreachable in development, an embedded in-memory MongoDB starts automatically.
MONGODB_URI=mongodb://127.0.0.1:27017/document_management

# Cloud Object Storage Configuration (AWS S3 / Cloudflare R2 / MinIO)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=document-vault-bucket

# Optional: S3-Compatible Endpoint (e.g. for Cloudflare R2 or MinIO)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false

# Upload Validation Settings
MAX_FILE_SIZE_MB=5

# Frontend API Base URL (empty for relative /api path or specify full URL)
VITE_API_BASE_URL=
